{
  "name": "jira-readonly-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "Read-only MCP server for Jira Cloud and Confluence, with an interactive installer",
  "license": "MIT",
  "keywords": [
    "mcp",
    "jira",
    "confluence",
    "atlassian",
    "claude",
    "model-context-protocol"
  ],
  "main": "dist/index.js",
  "bin": {
    "jira-readonly-mcp": "dist/index.js",
    "jira-mcp": "dist/index.js",
    "jira-mcp-add": "dist/cli/add.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/cli/add.ts",
    "test": "npm run build && node --test dist/*.test.js",
    "prepublishOnly": "npm run build",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "dotenv": "^16.4.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2"
  },
  "volta": {
    "node": "24.14.0"
  }
}
